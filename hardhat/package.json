{
  "name": "proofnews-contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "test:mutation": "node scripts/mutation.js",
    "node": "node scripts/local-node.js",
